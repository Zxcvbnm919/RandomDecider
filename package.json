{
  "name": "random-decision-tool",
  "private": true,
  "version": "1.0.0",
  "description": "离线、单机的随机决策辅助工具",
  "author": "Random Decider",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node test/setup.cjs && tsc -p tsconfig.core.json && node test/core.test.cjs",
    "test:core": "node test/setup.cjs && tsc -p tsconfig.core.json && node test/core.test.cjs",
    "electron": "electron .",
    "electron:build": "tsc --noEmit && vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.randomdecider.tool",
    "productName": "随机决策工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "executableName": "RandomDecider",
      "artifactName": "随机决策工具-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "随机决策工具-${version}-portable.exe",
      "unpackDirName": "RandomDecider"
    }
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.28.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
